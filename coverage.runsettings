<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[NaxcivanCS.Shared]*,[NaxcivanCS.Backend.Api]*,[NaxcivanCS.Server.Tests]NaxcivanCS.Server.*</Include>
          <!-- Server.Tests compiles two production server files by link. -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <Exclude>[NaxcivanCS.Server.Tests]NaxcivanCS.Server.Tests.*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
