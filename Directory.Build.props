<Project>

  <!-- PRD 154 - Coding standartlari: nullable reference types aktiv,
       warning-lar CI-de nezaretde saxlanilir. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1716: "Shared" ad fəzası PRD 121/153-də təsbit olunub, dəyişdirilmir. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <NaxcivanCSVersion>0.2.1</NaxcivanCSVersion>
    <Version>$(NaxcivanCSVersion)</Version>
    <Company>NaxcivanCS</Company>
    <Product>NaxcivanCS</Product>
  </PropertyGroup>

</Project>
